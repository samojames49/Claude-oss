# این فایل را به .env کپی کنید و مقادیر واقعی خود را وارد کنید:
#   cp .env.example .env
#
# ⚠️ هشدار امنیتی: توکن‌ها و کلیدهایی که قبلاً داخل کد بودند لو رفته‌اند.
# حتماً توکن ربات، API hash و شماره کارت را «باطل/تعویض» کنید و مقادیر جدید
# را اینجا بگذارید. فایل .env هرگز نباید کامیت شود (در .gitignore هست).

# ── حساب تلگرام (از my.telegram.org) ──────────────────────────────────────────
API_ID=123456
API_HASH=your_api_hash_here

# ── ربات سلف‌ساز (bot.py) ─────────────────────────────────────────────────────
BOT_TOKEN=123456:your_manager_bot_token
ADMIN_ID=123456789

# ── ربات هلپر (helper.py) ─────────────────────────────────────────────────────
HELPER_BOT_TOKEN=123456:your_helper_bot_token
HELPER_BOT_USERNAME=your_helper_bot_username   # بدون @
MANAGER_BOT_LINK=https://t.me/your_manager_bot
PANEL_IMAGE=                                    # لینک عکس پنل (اختیاری)

# ── عضویت اجباری (با کاما جدا کنید، بدون @) ───────────────────────────────────
FORCE_CHANNELS=channel1,channel2

# ── اقتصاد سکه ────────────────────────────────────────────────────────────────
COIN_RATE=1440              # تعداد سکه معادل COIN_PRICE_TOMAN
COIN_PRICE_TOMAN=50000      # قیمت COIN_RATE سکه به تومان
TAX_PERCENT=10
TAX_MIN_AMOUNT=2
FREE_STARTING_CREDITS=5

# ── پرداخت کارت‌به‌کارت (روش دستی؛ وقتی درگاه خاموش است) ──────────────────────
CARD_NUMBER=0000-0000-0000-0000
CARD_OWNER=نام صاحب کارت
CARD_BANK=نام بانک

# ── درگاه پرداخت آنی ریالی ────────────────────────────────────────────────────
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=zarinpal
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_CALLBACK_URL=https://example.com/verify
PAYMENT_GATEWAY_SANDBOX=false

# ── سرویس‌های خارجی سلف (قیمت ارز و اینستاگرام) ───────────────────────────────
PRICE_API_KEY=
INSTAGRAM_API_KEY=

# ── نگهداری و سلامت سرویس ─────────────────────────────────────────────────────
HEALTH_REPORT_ENABLED=true
HEALTH_REPORT_INTERVAL=3600   # ثانیه
AUTO_RESTART_ENABLED=true

# ── مسیر فایل‌ها (پیش‌فرض معمولاً کافی است) ───────────────────────────────────
SESSIONS_DIR=sessions
DATABASE_FILE=database.json
SELF_SCRIPT=self.py
