# ───────────────────────────────────────────────────────────────────────────────
# تنظیمات ربات پلیر (پخش موزیک و ویدیو در ویس‌چت گروه‌ها)
# این فایل را به player/.env کپی کنید و مقادیر خودتان را بگذارید.
# ───────────────────────────────────────────────────────────────────────────────

# ── ضروری ─────────────────────────────────────────────────────────────────────
# از my.telegram.org
API_ID=
API_HASH=
# توکن ربات از @BotFather
BOT_TOKEN=
# نشست اکانت کاربری «اسیستنت» (این اکانت داخل ویس‌چت می‌شود و صدا پخش می‌کند).
# با اسکریپت gen_session.py بسازید:  python -m player.tools.gen_session
STRING_SESSION=
# اسیستنت‌های بیشتر برای تقسیم بار روی گروه‌های زیاد (اختیاری)
STRING_SESSION2=
STRING_SESSION3=

# ── مدیریت ────────────────────────────────────────────────────────────────────
# آیدی عددی مالک ربات
OWNER_ID=
# آیدی ادمین‌های اضافی، جدا شده با کاما
SUDO_USERS=
# آیدی گروه لاگ (عدد منفی؛ ربات باید در آن ادمین باشد)
LOGGER_ID=
LOG_LEVEL=INFO

# ── برندینگ ───────────────────────────────────────────────────────────────────
BOT_NAME=Player
OWNER_USERNAME=
SUPPORT_CHAT=
SUPPORT_CHANNEL=
START_IMAGE=
PLAYER_IMAGE=
# fa یا en
DEFAULT_LANGUAGE=fa

# ── محدودیت‌ها و رفتار پخش ────────────────────────────────────────────────────
# سقف مدت هر آهنگ/ویدیو (دقیقه)
DURATION_LIMIT_MINUTES=180
# حداکثر آیتم در صف هر گروه
QUEUE_LIMIT=50
# تعداد نتایج جستجو
SEARCH_RESULTS_LIMIT=6
# سقف حجم فایل تلگرامی قابل پخش (مگابایت)
MAX_TELEGRAM_FILE_MB=300
# حداکثر تعداد گروه‌هایی که هم‌زمان پخش ویدیویی دارند
VIDEO_CALL_LIMIT=3
# everyone یا admins
PLAY_MODE=everyone
# direct = پخش از لینک مستقیم (سریع، بدون مصرف دیسک)
# download = اول دانلود بعد پخش (پایدارتر روی اینترنت ضعیف)
STREAM_MODE=direct
# studio | high | medium | low
AUDIO_QUALITY=high
# uhd | qhd | fhd | hd | sd
VIDEO_QUALITY=hd
# خروج خودکار اسیستنت وقتی کسی در ویس‌چت نیست
AUTO_LEAVE_ASSISTANT=true
INACTIVE_TIMEOUT_SECONDS=600
EMPTY_CALL_TIMEOUT_SECONDS=120
WATCHER_INTERVAL_SECONDS=30

# ── آمار کال ──────────────────────────────────────────────────────────────────
# ثبت زمان حضور اعضا در ویس‌چت و آمار روزانه/هفتگی
CALL_STATS_ENABLED=true
# بازهٔ نمونه‌برداری از لیست شرکت‌کنندگان (ثانیه)
CALL_STATS_INTERVAL_SECONDS=60
# چند روز آمار نگه داشته شود
CALL_STATS_KEEP_DAYS=40
# تعداد نفرات جدول آمار
CALL_STATS_TOP=20

# ── امنیت کال ─────────────────────────────────────────────────────────────────
CALL_SECURITY_ENABLED=false
# قدمت عضویتی که کاربر را از میوت خودکار ورودی معاف می‌کند (روز؛ ۰ = خاموش)
CALL_SECURITY_MIN_AGE_DAYS=7
# تعداد ورود مجاز هر عضو در یک کال، بیشتر از آن گزارش می‌شود
CALL_SECURITY_MAX_JOINS=5

# ── صندلی داغ ─────────────────────────────────────────────────────────────────
# زمان نوبت هر مهمان (ثانیه؛ ۰ = بی‌زمان)
HOTSEAT_TURN_SECONDS=180
HOTSEAT_MAX_GUESTS=30

# ── پخش زنده تلویزیون/ماهواره ────────────────────────────────────────────────
# مسیر فایل شبکه‌ها؛ خالی یعنی player/data/live_channels.json
LIVE_CHANNELS_FILE=

# ── زیرنویس ───────────────────────────────────────────────────────────────────
SUBTITLE_ENABLED=true
SUBTITLE_LANG=fa
SUBTITLE_FONT_SIZE=20
SUBTITLE_MAX_MB=5

# ── پیام‌ها ───────────────────────────────────────────────────────────────────
# چند ثانیه بعد، پیام پایان پخش پاک شود (با «پاکسازی خودکار» فعال)
AUTO_CLEAR_SECONDS=10
# سقف دعوت هر بار به ویس‌چت
INVITE_CALL_LIMIT=200

# ── دسترسی ────────────────────────────────────────────────────────────────────
# true = ربات فقط در گروه‌های تاییدشده (با /approve) کار می‌کند
PRIVATE_MODE=false
# یوزرنیم کانال عضویت اجباری (بدون @)
FORCE_SUB_CHANNEL=

# ── منابع خارجی ───────────────────────────────────────────────────────────────
# مسیر فایل کوکی یوتیوب (برای ویدیوهای محدودشده یا خطای «ربات نیستم»)
COOKIES_FILE=
# پروکسی برای yt-dlp، مثال: http://127.0.0.1:8080
YTDLP_PROXY=
LYRICS_ENABLED=true

# ── مسیرها ────────────────────────────────────────────────────────────────────
DOWNLOADS_DIR=
CACHE_DIR=
DB_FILE=
SESSION_DIR=
